@startuml "class-sprint2-ea"
hide circle
hide empty members
skinparam shadowing false
skinparam dpi 200
skinparam defaultFontName Arial
skinparam defaultFontSize 12
skinparam classAttributeIconSize 0
skinparam linetype ortho
skinparam nodesep 80
skinparam ranksep 90
skinparam roundCorner 0
skinparam stereotypeFontSize 11
skinparam class {
  BackgroundColor #FFFFCC
  BorderColor #000000
  ArrowColor #000000
  AttributeFontColor #000000
  StereotypeFontColor #000000
}
skinparam ArrowColor #000000

class Patient {
  + Id : Guid
  + ConquestPatientID : string
  + NationalId : string
  + FullName : string
  + BirthDate : DateOnly
  + Sex : string
  + PhoneNumber : string
  + Address : string
  + BloodGroup : string
  + IsIncomplete : bool
  + CreatedAt : DateTime
  + UpdatedAt : DateTime
  + RowVersion : byte[]
  --
  + RecomputeCompleteness() : void
}

class RiskProfile {
  + Id : Guid
  + Hypertension : bool
  + Diabetes : bool
  + Dyslipidemia : bool
  + Smoking : bool
  + FamilyHistory : bool
  + ObesityBMI : decimal
  + PriorMI : bool
  + PriorPCI : bool
  + PriorCABG : bool
  + EjectionFraction : decimal
  + Notes : string
  + CreatedAt : DateTime
}

class CathStudy {
  + Id : Guid
  + StudyInstanceUid : string
  + AccessionNumber : string
  + StudyDate : DateTime
  + Status : StudyStatus
  + CreatedAt : DateTime
}

enum StudyStatus <<enumeration>> {
  Pending
  Scheduled
  InProgress
  Completed
  Cancelled
}

interface IPacsReader <<interface>> {
  + GetStudyByUidAsync(studyInstanceUid : string) : PacsStudyDto
  + GetPendingStudiesAsync() : List<PacsStudyDto>
  + GetPatientStudiesAsync(patientId : string) : List<PacsStudyDto>
}

class OrthancPacsReader {
}

class PacsStudyDto <<DTO>> {
  + StudyInstanceUid : string
  + AccessionNumber : string
  + PatientId : string
  + PatientName : string
  + PatientBirthDate : DateOnly
  + PatientSex : string
  + StudyDate : DateOnly
  + Modality : string
}

class StudyIngestionService {
  + IngestStudyAsync(studyInstanceUid : string) : IngestResult
  + IngestAllPendingAsync() : List<IngestResult>
}

' Composition : le profil de risque n'existe pas sans son patient
Patient "1" *-- "0..1" RiskProfile : possède >
' Association bidirectionnelle (Patient.Studies / CathStudy.Patient)
Patient "1" -- "0..*" CathStudy : fait l'objet de >
' Association unidirectionnelle vers l'énumération
CathStudy "0..*" --> "1" StudyStatus : a pour statut >
' Réalisation de l'interface
OrthancPacsReader ..|> IPacsReader : <<realize>>
' Dépendances d'usage
IPacsReader ..> PacsStudyDto : <<use>>
StudyIngestionService "1" --> "1" IPacsReader : lit le PACS via >
StudyIngestionService ..> Patient : <<use>>
StudyIngestionService ..> CathStudy : <<use>>
@enduml