@startuml CathLabDB_ClassDiagram

skinparam classAttributeIconSize 0
skinparam classFontSize 15
skinparam classAttributeFontSize 12
skinparam classBorderThickness 2
skinparam linetype polyline
skinparam ranksep 90
skinparam nodesep 70
skinparam padding 8

' ════════════════════════════════════════════════════════════
'  LAYER 1 — PACS  (lecture seule — Orthanc en dev,
'                   Conquest en prod)
' ════════════════════════════════════════════════════════════

package "Layer 1 · PACS  [lecture seule]" #E6F1FB {

  class PacsStudyDto <<DTO>> {
    StudyInstanceUid  : string
    AccessionNumber   : string
    PatientId         : string
    PatientName       : string
    PatientBirthDate  : DateOnly
    PatientSex        : string
    StudyDate         : DateOnly
    Modality          : string
  }

  note bottom of PacsStudyDto
    Objet neutre produit par
    IPacsReader à partir de :
    • DicomIdentifiers + MainDicomTags
      (Orthanc — dev)
    • Vue PacsStudy du schéma
      Conquest (prod)
    Le reste de l'application
    ne voit jamais la source réelle.
  end note

  interface IPacsReader <<interface>> {
    + GetStudyByAccessionAsync(accessionNumber) : PacsStudyDto
    + GetPendingStudiesAsync(since) : List<PacsStudyDto>
    + GetPatientStudiesAsync(patientId) : List<PacsStudyDto>
  }

  class OrthancPacsReader <<Infrastructure>> {
    - _orthancContext : OrthancPacsContext
    + GetStudyByAccessionAsync(accessionNumber) : PacsStudyDto
    + GetPendingStudiesAsync(since) : List<PacsStudyDto>
    + GetPatientStudiesAsync(patientId) : List<PacsStudyDto>
  }

  class OrthancRestClient <<Infrastructure>> {
    - _httpClient : HttpClient
    + GetInstancesForStudyAsync(studyUid) : List<string>
    + GetInstancePreviewUrlAsync(instanceUid) : string
    + GetWadoUriAsync(studyUid, seriesUid, instanceUid) : string
  }

  IPacsReader <|.. OrthancPacsReader : implémente
  OrthancPacsReader ..> PacsStudyDto  : produit
}

' ════════════════════════════════════════════════════════════
'  LAYER 2 — CathLabDB  [lecture / écriture]
' ════════════════════════════════════════════════════════════

package "Layer 2 · CathLabDB  [lecture / écriture]" #E1F5EE {

  ' ── Domaine : Utilisateurs ───────────────────────────────

  class AppUser <<entity>> {
    + Id           : Guid      <<PK>>
    --
    Username       : string
    PasswordHash   : string
    FullName       : string
    Specialty      : string
    Role           : UserRole
    IsActive       : bool
    CreatedAt      : DateTime
  }

  ' ── Domaine : Patient ────────────────────────────────────

  class Patient <<entity>> {
    + Id                : Guid      <<PK>>
    # CreatedBy         : Guid      <<FK>>
    --
    ConquestPatientID   : string
    NationalId          : string
    FullName            : string
    BirthDate           : DateOnly
    Sex                 : string
    PhoneNumber         : string
    Address             : string
    BloodGroup          : string
    CreatedAt           : DateTime
    UpdatedAt           : DateTime
  }

  class RiskProfile <<entity>> {
    + Id               : Guid    <<PK>>
    # PatientId        : Guid    <<FK>>
    --
    Hypertension       : bool
    Diabetes           : bool
    Dyslipidemia       : bool
    Smoking            : bool
    FamilyHistory      : bool
    ObesityBMI         : decimal
    PriorMI            : bool
    PriorPCI           : bool
    PriorCABG          : bool
    EjectionFraction   : decimal
    Notes              : string
    CreatedAt          : DateTime
  }

  ' ── Domaine : Étude & Compte-rendu ───────────────────────

  class CathStudy <<entity>> {
    + Id               : Guid      <<PK>>
    # PatientId        : Guid      <<FK>>
    # OperatorId       : Guid      <<FK>>
    --
    AccessionNumber    : string
    StudyDate          : DateTime
    Status             : StudyStatus
    CreatedAt          : DateTime
  }

  class ProcedureReport <<entity>> {
    + Id                   : Guid      <<PK>>
    # CathStudyId          : Guid      <<FK>>
    --
    Approach               : string
    CatheterUsed           : string
    ContrastVolume_mL      : decimal
    DoseAreaProduct_Gycm2  : decimal
    DominanceType          : string
    TIMIFlowBaseline       : byte
    TIMIFlowFinal          : byte
    Conclusion             : string
    ReportGeneratedAt      : DateTime
    PdfStoragePath         : string
  }

  ' ── Domaine : Lésions coronaires ─────────────────────────

  class CoronaryLesion <<entity>> {
    + Id                : Guid    <<PK>>
    # ProcedureReportId : Guid    <<FK>>
    --
    Vessel              : string
    SegmentNumber       : byte
    StenosisPercent     : byte
    LesionType          : LesionType
    TIMIFlow            : byte
    IsTreated           : bool
  }

  abstract class LesionTreatment <<entity>> {
    + Id               : Guid    <<PK>>
    # LesionId         : Guid    <<FK>>
    # InventoryItemId  : Guid    <<FK>>
    --
    TIMIFlowAfter      : byte
    PerformedAt        : DateTime
    Notes              : string
  }

  class StentImplant <<entity>> {
    LandingZoneProximal   : string
    LandingZoneDistal     : string
    StentDiameter_mm      : decimal
    StentLength_mm        : decimal
    PostDilationPerformed : bool
    PostDilationPressure  : byte
  }

  class BalloonDilation <<entity>> {
    BalloonDiameter_mm    : decimal
    BalloonLength_mm      : decimal
    MaxPressure_atm       : byte
    InflationDuration_sec : int
    IsPreDilation         : bool
    IsPostDilation        : bool
  }

  ' ── Domaine : Pharmacie ──────────────────────────────────

  class InventoryProduct <<entity>> {
    + Id              : Guid    <<PK>>
    --
    Reference         : string
    ProductName       : string
    DeviceType        : DeviceType
    Manufacturer      : string
    UnitOfMeasure     : string
    MinimumStockLevel : int
    CurrentStock      : int
    CreatedAt         : DateTime
  }

  class InventoryItem <<entity>> {
    + Id                     : Guid      <<PK>>
    # ProductId              : Guid      <<FK>>
    # ReservedForCathStudyId : Guid?     <<FK>>
    --
    Barcode                  : string
    LotNumber                : string
    ExpiryDate               : DateOnly
    SerialNumber             : string
    Status                   : ItemStatus
    ReceivedAt               : DateTime
    ReservedAt               : DateTime?
    ConsumedAt               : DateTime?
  }

  note right of InventoryItem
    Cycle de vie (Status) :
    InStock   -> Reserved   (sélection par le
                 cardiologue dans l'UI de
                 segmentation, avant la fin
                 de la procédure)
    Reserved  -> Consumed   (rapport finalisé,
                 dispositif implanté)
    Reserved  -> Wasted     (ouvert mais non
                 implanté — ne peut pas
                 retourner en stock)
    Reserved  -> InStock    (désélectionné,
                 jamais ouvert)
    ReservedForCathStudyId évite qu'un même
    item physique soit réservé par deux
    procédures concurrentes.
  end note

  class StockMovement <<entity>> {
    + Id              : Guid    <<PK>>
    # ProductId       : Guid    <<FK>>
    # CreatedBy       : Guid    <<FK>>
    --
    MovementType      : MovementType
    Quantity          : int
    ReferenceNote     : string
    MovedAt           : DateTime
  }

  note right of StockMovement
    Un StockMovement n'est créé qu'à la
    transition terminale de l'item
    (Consumed / Wasted / Return / Expiry),
    jamais à la simple réservation.
  end note

  ' ── Énumérations ─────────────────────────────────────────

  enum StudyStatus {
    Scheduled
    InProgress
    Completed
    Cancelled
  }

  enum LesionType {
    TypeA
    TypeB1
    TypeB2
    TypeC
  }

  enum UserRole {
    Medecin
    Secretaire
    SurveillantBloc
    ResponsablePharmacie
    Admin
  }

  enum DeviceType {
    Stent
    Balloon
    GuideCatheter
    Sheath
    Other
  }

  enum ItemStatus {
    InStock
    Reserved
    Consumed
    Wasted
    Expired
  }

  enum MovementType {
    Reception
    Consumption
    Return
    Adjustment
    Waste
    Expiry
  }

  ' ── Associations ─────────────────────────────────────────

  Patient          "1"    *--  "1"      RiskProfile
  Patient          "1"    *--  "1..*"   CathStudy
  Patient          "0..*" --   "1"      AppUser           : CreatedBy

  CathStudy        "1"    *--  "0..1"   ProcedureReport   : CathStudyId
  CathStudy        "0..*" --   "1"      AppUser           : OperatorId
  CathStudy        "0..*" --   "0..*"   InventoryItem     : ReservedForCathStudyId

  ProcedureReport  "1"    *--  "0..*"   CoronaryLesion    : ProcedureReportId
  CoronaryLesion   "1"    *--  "0..*"   LesionTreatment   : LesionId
  LesionTreatment  "1"    --   "0..1"   InventoryItem     : InventoryItemId
  LesionTreatment  <|--   StentImplant
  LesionTreatment  <|--   BalloonDilation

  InventoryItem    "0..*" --   "1"      InventoryProduct  : ProductId
  StockMovement    "0..*" --   "1"      InventoryProduct  : ProductId
  StockMovement    "0..*" --   "1"      AppUser           : CreatedBy

  ' ── Énumérations ─────────────────────────────────────────

  CathStudy        ..  StudyStatus
  CoronaryLesion   ..  LesionType
  AppUser          ..  UserRole
  InventoryProduct ..  DeviceType
  InventoryItem    ..  ItemStatus
  StockMovement    ..  MovementType

  note right of InventoryProduct
    CurrentStock est un cache calculé.
    Source de vérité = somme de
    StockMovement.Quantity pour ce
    produit. Recalculé à chaque
    écriture Reception / Consumption.
  end note

  note right of LesionTreatment
    Stratégie TPT (Table Per Type)
    en Entity Framework Core.
    StentImplant et BalloonDilation
    partagent la PK de LesionTreatment
    via une relation 1-à-1.
    Chaque LesionTreatment référence
    exactement 1 InventoryItem physique
    (dispositif à usage unique) — la
    relation est donc 1-à-1, jamais
    partagée entre plusieurs traitements.
  end note
}

' ════════════════════════════════════════════════════════════
'  RÉFÉRENCES CROISÉES  (soft references)
' ════════════════════════════════════════════════════════════

PacsStudyDto  ..>  Patient    : «seeds»\nPatientId → ConquestPatientID
PacsStudyDto  ..>  CathStudy  : «seeds»\nAccessionNumber → AccessionNumber

note as N1
  Aucune FK base de données
  ne franchit la frontière
  des deux schémas.
  Résolution à l'exécution
  par StudyIngestionService
  via IPacsReader.
end note

@enduml
