@startuml CathLabDB_ClassDiagram

title CathLab — Domain Class Diagram
skinparam titleFontSize 22
skinparam titleFontStyle bold

skinparam classAttributeIconSize 0
skinparam classFontSize 15
skinparam classFontStyle bold
skinparam classAttributeFontSize 12
skinparam classAttributeFontName Consolas
skinparam classBorderThickness 1.5
skinparam classBackgroundColor White
skinparam linetype polyline
skinparam ranksep 90
skinparam nodesep 65
skinparam padding 8
skinparam shadowing false
skinparam packageStyle rectangle
skinparam packageFontSize 16
skinparam packageFontStyle bold
skinparam noteBackgroundColor #FFFDF0
skinparam noteBorderColor #D6C88A
skinparam arrowColor #55606B
skinparam arrowFontSize 11

' ════════════════════════════════════════════════════════════
'  CathLab — Domain Class Diagram
'  Schema of the application database (CathLabDB).
'  Patient and CathStudy rows are seeded from PACS on admission
'  via IPacsReader, but no DB foreign key crosses that boundary
'  — see the ingestion flow docs for that integration layer.
'
'  Corrected against live EF Core logs (2026-08-23):
'   - Removed AppUser.Specialty (dropped by migration, per README)
'   - Added CathStudy.StudyInstanceUid (present in real INSERT/SELECT)
'   - Patient's creator FK is CreatedByUserId (the actual EF Core
'     shadow property backing CreatedByUser), not CreatedBy.
'     A legacy/duplicate CreatedBy column exists in the live DB —
'     known bug, tracked in the note below.
'
'  Corrected against CoronaryLesion.cs (2026-08-23):
'   - TimiFlow is nullable (byte?)
'   - Added RefDiam, Calcified, Thrombus, ResidualStenosis,
'     CreatedAt, CreatedByUserId
'   - CreatedByUserId is typed string?, not Guid? — flagged as
'     a likely bug, see note on CoronaryLesion below.
'   - De Novo / ISR classification still does not exist on this
'     entity — remains a genuinely open question.
' ════════════════════════════════════════════════════════════

package "CathLabDB" #E1F5EE {

  ' ── Users ─────────────────────────────────────────────────

  class AppUser <<entity>> {
    + Id           : Guid      <<PK>>
    --
    Username       : string
    PasswordHash   : string
    FullName       : string
    Role           : UserRole
    IsActive       : bool
    CreatedAt      : DateTime
  }

  ' ── Patient ───────────────────────────────────────────────

  class Patient <<entity>> {
    + Id                : Guid      <<PK>>
    # CreatedByUserId    : Guid      <<FK>>
    --
    ConquestPatientID   : string
    NationalId          : string
    FullName            : string
    BirthDate           : DateOnly
    Sex                 : string
    PhoneNumber         : string
    Address             : string
    BloodGroup          : string
    IsIncomplete        : bool
    CreatedAt           : DateTime
    UpdatedAt           : DateTime
  }

  class RiskProfile <<entity>> {
    + Id               : Guid    <<PK>>
    # PatientId        : Guid    <<FK>>
    --
    Hypertension       : bool
    Diabetes           : bool
    Dyslipidemia       : bool
    Smoking            : bool
    FamilyHistory      : bool
    ObesityBMI         : decimal
    PriorMI            : bool
    PriorPCI           : bool
    PriorCABG          : bool
    EjectionFraction   : decimal
    Notes              : string
  }

  ' ── Study & Report ───────────────────────────────────────

  class CathStudy <<entity>> {
    + Id               : Guid      <<PK>>
    # PatientId        : Guid      <<FK>>
    # OperatorId       : Guid      <<FK>>
    --
    AccessionNumber    : string
    StudyInstanceUid   : string
    StudyDate          : DateTime
    Status             : StudyStatus
    CreatedAt          : DateTime
  }

  class ProcedureReport <<entity>> {
    + Id                   : Guid      <<PK>>
    # CathStudyId          : Guid      <<FK>>
    # ConfirmedByUserId    : Guid?     <<FK>>
    --
    Approach               : string
    CatheterUsed           : string
    ContrastVolumeMl       : decimal
    DoseAreaProductGycm2   : decimal
    DominanceType          : string
    TimiFlowBaseline       : byte
    TimiFlowFinal          : byte
    Conclusion             : string
    Recommendations        : string
    IsConfirmed            : bool
    ReportGeneratedAt      : DateTime
    ConfirmedAt            : DateTime?
    PdfStoragePath         : string
  }

  ' ── Coronary Lesions ──────────────────────────────────────

  class CoronaryLesion <<entity>> {
    + Id                : Guid      <<PK>>
    # ProcedureReportId  : Guid      <<FK>>
    --
    Vessel              : string
    SegmentNumber       : byte
    StenosisPercent     : byte
    LesionType          : LesionType
    TimiFlow            : byte?
    IsTreated           : bool
    RefDiam             : string?
    Calcified           : bool
    Thrombus            : bool
    ResidualStenosis    : string?
    CreatedAt           : DateTime
    CreatedByUserId     : string?
  }


  abstract class LesionTreatment <<entity>> {
    + Id               : Guid    <<PK>>
    # LesionId         : Guid    <<FK>>
    # InventoryItemId  : Guid    <<FK>>
    --
    TIMIFlowAfter      : byte
    PerformedAt        : DateTime
    Notes              : string
  }

  class StentImplant <<entity>> {
    LandingZoneProximal   : string
    LandingZoneDistal     : string
    StentDiameter_mm      : decimal
    StentLength_mm        : decimal
    PostDilationPerformed : bool
    PostDilationPressure  : byte
  }

  class BalloonDilation <<entity>> {
    BalloonDiameter_mm    : decimal
    BalloonLength_mm      : decimal
    MaxPressure_atm       : byte
    InflationDuration_sec : int
    IsPreDilation         : bool
    IsPostDilation        : bool
  }

  ' ── Pharmacy ──────────────────────────────────────────────

  class InventoryProduct <<entity>> {
    + Id              : Guid    <<PK>>
    --
    Reference         : string
    ProductName       : string
    DeviceType        : DeviceType
    Manufacturer      : string
    UnitOfMeasure     : string
    MinimumStockLevel : int
    CurrentStock      : int
    CreatedAt         : DateTime
  }

  class InventoryItem <<entity>> {
    + Id                     : Guid      <<PK>>
    # ProductId              : Guid      <<FK>>
    # ReservedForCathStudyId : Guid?     <<FK>>
    --
    Barcode                  : string
    LotNumber                : string
    ExpiryDate               : DateOnly
    SerialNumber             : string
    Status                   : ItemStatus
    ReceivedAt               : DateTime
    ConsumedAt               : DateTime?
  }

  class StockMovement <<entity>> {
    + Id              : Guid    <<PK>>
    # ProductId       : Guid    <<FK>>
    # CreatedBy       : Guid    <<FK>>
    --
    MovementType      : MovementType
    Quantity          : int
    ReferenceNote     : string
    MovedAt           : DateTime
  }

  note right of StockMovement
    A StockMovement is only created at the item's
    terminal transition (Consumed / Wasted / Return /
    Expiry) — never at simple reservation.
  end note

  ' ── Enumerations ──────────────────────────────────────────

  enum StudyStatus {
    Scheduled
    InProgress
    Completed
    Cancelled
  }

  enum LesionType {
    TypeA
    TypeB1
    TypeB2
    TypeC
  }

  enum UserRole {
    Medecin
    Secretaire
    ResponsablePharmacie
    Admin
  }

  enum DeviceType {
    Stent
    Balloon
    GuideCatheter
    Sheath
    Other
  }

  enum ItemStatus {
    InStock,
    Reserved,
    Consumed,
    Wasted,
    Expired
  }

  enum MovementType {
    Reception,   
    Consumption, 
    Return,     
    Waste
  }

  ' ── Associations ──────────────────────────────────────────

  Patient          "1"    *--   "1"      RiskProfile
  Patient          "1"    *--   "1..*"   CathStudy
  Patient          "0..*" --    "1"      AppUser           : CreatedByUserId

  CathStudy        "1"    *--   "0..1"   ProcedureReport   : CathStudyId
  CathStudy        "0..*" --    "1"      AppUser           : OperatorId
  CathStudy        "1"    --    "0..*"   InventoryItem     : ReservedForCathStudyId

  ProcedureReport  "0..*" --    "0..1"   AppUser           : ConfirmedByUserId
  ProcedureReport  "1"    *--   "0..*"   CoronaryLesion    : ProcedureReportId
  CoronaryLesion   "1"    *--   "0..*"   LesionTreatment   : LesionId
  LesionTreatment  "1"    --    "1"      InventoryItem     : InventoryItemId
  LesionTreatment  <|--   StentImplant
  LesionTreatment  <|--   BalloonDilation

  InventoryItem    "0..*" --    "1"      InventoryProduct  : ProductId
  StockMovement    "0..*" --    "1"      InventoryProduct  : ProductId
  StockMovement    "0..*" --    "1"      AppUser           : CreatedBy

  ' ── Enum links ─────────────────────────────────────────────

  CathStudy        ..  StudyStatus
  CoronaryLesion   ..  LesionType
  AppUser          ..  UserRole
  InventoryProduct ..  DeviceType
  InventoryItem    ..  ItemStatus
  StockMovement    ..  MovementType

  note right of InventoryProduct
    CurrentStock is a computed cache.
    Source of truth = sum of StockMovement.Quantity
    for this product. Recalculated on every
    Reception / Consumption write.
  end note

  note right of LesionTreatment
    Table-Per-Type (TPT) strategy in EF Core.
    StentImplant and BalloonDilation share the
    LesionTreatment PK via a 1-to-1 relationship.
    Each LesionTreatment references exactly one
    physical InventoryItem (single-use device) —
    the relation is therefore 1-to-1, never shared
    across multiple treatments.
  end note
}
@enduml