@startuml Architecture_PACS_CardioFlow
skinparam shadowing false
skinparam nodesep 60
skinparam ranksep 80
skinparam defaultFontSize 12
skinparam arrowFontSize 11
title CardioFlow – Architecture de déploiement et flux DICOM

' =========================
' ACQUISITION DES IMAGES
' =========================
package "Modalités d'imagerie" #F5F5F5 {
  [Philips XA\n(angiographe)] as philips
  [Autres modalités DICOM\n(optionnel)] as other
}

package "PACS hérité (optionnel)" #FFF3E0 {
  [Serveur ConQuest\n(archive DICOM)] as conquest
}

' =========================
' SERVEUR PACS
' =========================
package "Serveur PACS – Orthanc (conteneur)" #E3F2FD {
  [Service DICOM\nC-STORE · port 4242] as dicom
  [API REST + DICOMweb\nport 8042 · authentification Basic] as rest
  [Fichiers DICOM (.dcm)\nstockage sur disque] as files
}

' =========================
' BASES DE DONNÉES
' =========================
package "SQL Server (port 1433)" #FFFDE7 {
  database "OrthancPACS\n(index DICOM)" as idx
  database "CathLabDB\n(données cliniques)" as cathdb
}

' =========================
' APPLICATION CARDIOFLOW
' =========================
package "Conteneur api – ASP.NET Core" #E8F5E9 {
  [API CathLab\n(contrôleurs REST · JWT)] as api
  [Worker d'ingestion\n(PacsIngestionWorker)] as worker
}

package "Conteneur web – nginx" #EDE7F6 {
  [nginx\nfichiers statiques\net reverse proxy /api] as nginx
}

package "Navigateur de l'utilisateur" #F3E5F5 {
  [Interface web\nHTML / JavaScript] as ui
  [Visualiseur DICOM\nCornerstone3D] as viewer
}

' =========================
' FLUX : ACQUISITION
' =========================
philips --> dicom : C-STORE
other --> dicom : C-STORE
conquest --> dicom : C-STORE\n(routage optionnel)

dicom --> files : écrit les instances
dicom --> idx : indexe les études\n(plugin ODBC)
rest --> files : lit les images

' =========================
' FLUX : APPLICATION
' =========================
ui --> nginx : HTTP /api/...
viewer --> nginx : HTTP /api/dicom/...\n(jeton JWT)
nginx --> api : proxy /api

api --> cathdb : EF Core\n(lecture / écriture)
api --> idx : EF Core\n(lecture seule)
api --> rest : HTTP (Basic)\nimages, aperçus, DICOMweb

worker --> idx : interroge périodiquement\nles nouvelles études
worker --> cathdb : ingère patients\net études (idempotent)

note right of api
  L'API et le worker lisent l'index Orthanc
  (SQL Server) en lecture seule, et récupèrent
  les images via l'API REST d'Orthanc.
  Le visualiseur n'accède jamais directement
  à Orthanc : tout passe par l'API (JWT).

  Identifiants DICOM utilisés :
  - PatientID (0010,0020)
  - StudyInstanceUID (0020,000D)
  - AccessionNumber (0008,0050)
end note

@enduml