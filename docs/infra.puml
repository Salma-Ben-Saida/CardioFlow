@startuml Figure_3_4_Architecture_physique
' Figure 3.4 – Architecture physique et déploiement (CardioFlow)
' Diagramme de déploiement UML – style Enterprise Architect

skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam defaultFontName Arial
skinparam defaultFontSize 11
skinparam linetype ortho
skinparam nodesep 80
skinparam ranksep 70

skinparam node {
  BackgroundColor #FFFFCC
  BorderColor #000000
  FontColor #000000
  StereotypeFontSize 10
}
skinparam artifact {
  BackgroundColor #FFFFFF
  BorderColor #000000
}
skinparam component {
  BackgroundColor #FFFFFF
  BorderColor #000000
}
skinparam database {
  BackgroundColor #FFFFFF
  BorderColor #000000
}
skinparam actor {
  BackgroundColor #FFFFFF
  BorderColor #000000
}
skinparam interface {
  BackgroundColor #FFFFFF
  BorderColor #000000
}
skinparam arrow {
  Color #000000
  FontSize 10
}
skinparam note {
  BackgroundColor #FFFFE0
  BorderColor #000000
}

title Figure 3.4 – Architecture physique et déploiement

actor "Utilisateur\n(médecin / personnel)" as user
node "Poste client" as client <<dispositif>> {
  artifact "Navigateur web" as browser <<artefact>>
}

node "Hôte Docker" as host <<environnement d'exécution>> {

  node "Docker Compose (racine du projet)" as compose1 <<réseau Docker>> {

    node "Conteneur web" as web <<conteneur nginx:alpine>> {
      component "Serveur nginx\n(port 80)" as nginx
      artifact "Frontend statique\n(HTML / CSS / JS)" as front <<artefact>>
      artifact "Visualiseur Cornerstone3D\n(/viewer)" as viewer <<artefact>>
    }

    node "Conteneur api" as api <<conteneur ASP.NET Core>> {
      component "API Web CardioFlow\n(port 8080)" as webapi
      component "Service d'ingestion PACS\n(arrière-plan)" as ingest
      component "PacsReader\n(IPacsReader)" as reader
      artifact "Rapports et App_Data\n(volumes)" as vols <<volume>>
    }
  }

  node "Docker Compose (database/)" as compose2 <<réseau cathlab-net>> {
    node "Conteneur Orthanc\n(cathlab-orthanc)" as orthanc <<conteneur Orthanc>> {
      component "Serveur PACS Orthanc\n(DICOM 4242 · HTTP 8042)" as orthcomp
      component "Plugin DICOMweb\n(/dicom-web)" as dweb
      component "Plugin ODBC\n(ODBC Driver 18)" as odbc
      artifact "orthanc.json\n(lecture seule)" as cfg <<configuration>>
    }
  }

  node "Conteneur SQL Server" as sql <<conteneur mssql/server:2022>> {
    database "CathLabDB\n(base applicative)" as cathdb
    database "OrthancPACS\n(index DICOM)" as orthdb
  }

  node "Stockage local" as disk <<système de fichiers>> {
    artifact "Fichiers DICOM (.dcm)" as dcm <<artefact>>
  }
}

node "Modalité d'imagerie\n(angiographe / storescu)" as modality <<dispositif>>

' --- Flux utilisateur ---
user -- browser
browser --> nginx : HTTP (80)\nURL relatives /api
nginx ..> front : sert
nginx ..> viewer : sert
nginx --> webapi : proxy /api/\nHTTP (8080)

' --- Intégration PACS ---
ingest --> reader : utilise
reader --> dweb : REST / DICOMweb\nhost.docker.internal:8042
webapi --> dweb : relais DICOMweb\n(lecture des études)
viewer ..> webapi : DICOMweb via /api

' --- Accès aux données ---
webapi --> cathdb : EF Core\nhost.docker.internal:1433
ingest --> cathdb : création patients\net examens
odbc --> orthdb : ODBC\nhost.docker.internal:1433
orthcomp --> dcm : stockage des fichiers
orthcomp ..> cfg : lit
orthcomp ..> dweb
orthcomp ..> odbc

' --- Acquisition ---
modality --> orthcomp : DICOM C-STORE\n(4242)

note bottom of host
  Les conteneurs api et Orthanc joignent SQL Server et Orthanc
  via host.docker.internal (extra_hosts : host-gateway).
end note

@enduml